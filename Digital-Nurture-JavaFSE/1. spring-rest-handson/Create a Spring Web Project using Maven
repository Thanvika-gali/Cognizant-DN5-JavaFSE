4. Country Bean Class

The Country class is a simple Java Bean that stores country information.

package com.cognizant.springlearn;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

public class Country {

    private static final Logger LOGGER =
            LoggerFactory.getLogger(Country.class);

    private String code;
    private String name;

    public Country() {

        LOGGER.debug("Country object created.");

    }

    public String getCode() {

        LOGGER.debug("Reading country code.");

        return code;
    }

    public void setCode(String code) {

        LOGGER.debug("Updating country code.");

        this.code = code;
    }

    public String getName() {

        LOGGER.debug("Reading country name.");

        return name;
    }

    public void setName(String name) {

        LOGGER.debug("Updating country name.");

        this.name = name;
    }

    @Override
    public String toString() {

        return "Country [code=" + code + ", name=" + name + "]";

    }

}
