3. Country Controller

The controller receives client requests and forwards them to the service layer.

CountryController.java
package com.cognizant.springlearn.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.cognizant.springlearn.model.Country;
import com.cognizant.springlearn.service.CountryService;
import com.cognizant.springlearn.service.exception.CountryNotFoundException;

@RestController
public class CountryController {

    @Autowired
    private CountryService countryService;

    @RequestMapping("/country")
    public Country getIndia() {

        System.out.println("Fetching India");

        Country country = countryService.getCountry("IN");

        System.out.println("Returning India");

        return country;

    }

    @GetMapping("/countries")
    public List<Country> fetchCountries() {

        System.out.println("Fetching all countries");

        List<Country> list = countryService.getAllCountries();

        System.out.println("Returning country list");

        return list;

    }

    @GetMapping("/countries/{code}")
    public Country fetchCountry(@PathVariable String code)
            throws CountryNotFoundException {

        System.out.println("Searching country : " + code);

        Country country = countryService.getCountry(code);

        System.out.println("Country found");

        return country;

    }

}
Explanation
@Autowired
@Autowired
private CountryService countryService;

Spring automatically injects the CountryService object.

No need to create

new CountryService();
